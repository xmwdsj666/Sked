<script>
/**
 * 应用入口：全局生命周期。
 * 注意：不要在模块加载或 onInit 之前调用 Feature API（编译期静态预渲染限制）。
 * onCreate 预热快照读取：file.readText 只有异步形态，启动期发起、
 * 回调完成后缓存到 store，供主存损坏时 load() 同步取用。
 */
import { primeSnapshot } from './store/index.js'

export default {
  onCreate() {
    try {
      primeSnapshot()
    } catch (e) {
      // 快照预热失败不影响主流程
    }
  },
  onDestroy() {}
}
</script>
