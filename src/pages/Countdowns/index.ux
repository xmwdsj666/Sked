<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true">
      <div class="content">
        <text class="title">考试与假期</text>
        <text class="subtitle">长按删除条目</text>

        <div for="{{row in rows}}" tid="{{row.key}}">
          <div class="row press" onlongpress="onRowDelete($idx)">
            <div class="row-left">
              <div class="kind-dot" style="background-color: {{row.color}};"></div>
              <text class="row-name">{{row.name}}</text>
              <text class="row-date">{{row.dateLabel}}</text>
            </div>
            <text class="row-days" style="color: {{row.color}};">{{row.daysLabel}}</text>
          </div>
        </div>

        <div if="{{rows.length === 0}}" class="empty">
          <text class="empty-txt">还没有倒计时，点下方添加</text>
        </div>

        <div class="seg">
          <div class="seg-btn {{kind === 'exam' ? 'seg-on-exam' : ''}}" onclick="onKindExam">
            <text class="seg-txt {{kind === 'exam' ? 'seg-txt-exam' : ''}}">考试</text>
          </div>
          <div class="seg-btn {{kind === 'holiday' ? 'seg-on-holiday' : ''}}" onclick="onKindHoliday">
            <text class="seg-txt {{kind === 'holiday' ? 'seg-txt-holiday' : ''}}">假期</text>
          </div>
        </div>

        <div class="editor">
          <text class="ed-label">名称</text>
          <picker class="ed-picker-s" type="text" range="{{nameRange}}" selected="{{nameSel}}" onchange="onNamePick"></picker>
          <text class="ed-label">日期</text>
          <picker class="ed-picker-s" type="date" start="2026-1-1" end="2030-12-31" selected="{{dateVal}}" onchange="onDatePick"></picker>
          <div class="add-btn press" onclick="onAdd">
            <text class="add-txt">添加{{kind === 'exam' ? '考试' : '假期'}}倒计时</text>
          </div>
        </div>

        <div class="gap"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import sys from '../../helper/sys.js'
import { load, getData, save } from '../../store/index.js'
import { genId, EXAM_NAME_PRESETS, HOLIDAY_NAME_PRESETS } from '../../core/defaults.js'
import { daysUntil } from '../../core/timetable.js'

export default {
  data: {
    rows: [],
    kind: 'exam',
    nameRange: EXAM_NAME_PRESETS,
    nameSel: 0,
    dateVal: '2026-10-1',
    pickedDate: ''
  },

  onInit() {
    this._loaded = false
  },

  onReady() {
    this._loaded = true
    load()
    this.refresh()
  },

  onShow() {
    if (this._loaded) this.refresh()
  },

  refresh() {
    if (!this._loaded) return
    const st = getData()
    if (!st) return
    const now = new Date()
    const rows = []
    for (let i = 0; i < st.countdowns.length; i++) {
      const c = st.countdowns[i]
      const n = daysUntil(c.date, now)
      const p = String(c.date).split('-')
      rows.push({
        key: c.id || (c.name + i),
        id: c.id || (c.name + i),
        name: c.name,
        color: c.kind === 'exam' ? '#FF453A' : '#0A84FF',
        dateLabel: parseInt(p[0], 10) + '.' + parseInt(p[1], 10) + '.' + parseInt(p[2], 10),
        daysLabel: n < 0 ? '已过' : (n === 0 ? '今天' : n + ' 天')
      })
    }
    rows.sort(function (a, b) { return 0 })
    this.rows = rows
  },

  onKindExam() {
    this.kind = 'exam'
    this.nameRange = EXAM_NAME_PRESETS
    this.nameSel = 0
    sys.vibrateShort()
  },

  onKindHoliday() {
    this.kind = 'holiday'
    this.nameRange = HOLIDAY_NAME_PRESETS
    this.nameSel = 0
    sys.vibrateShort()
  },

  onNamePick(e) {
    if (!e) return
    for (let i = 0; i < this.nameRange.length; i++) {
      if (this.nameRange[i] === e.newValue) { this.nameSel = i; break }
    }
  },

  onDatePick(e) {
    if (!e) return
    const pad = function (n) { return n < 10 ? '0' + n : '' + n }
    this.pickedDate = e.year + '-' + pad(e.month) + '-' + pad(e.day)
    this.dateVal = e.year + '-' + e.month + '-' + e.day
    this.dateLabel = e.year + '.' + e.month + '.' + e.day
  },

  onAdd() {
    const st = getData()
    if (!st) return
    const name = this.nameRange[this.nameSel]
    let date = this.pickedDate
    if (!date) {
      const t = new Date()
      t.setDate(t.getDate() + 30)
      const pad = function (n) { return n < 10 ? '0' + n : '' + n }
      date = t.getFullYear() + '-' + pad(t.getMonth() + 1) + '-' + pad(t.getDate())
    }
    st.countdowns.push({ id: genId(), kind: this.kind, name: name, date: date })
    save(st)
    sys.vibrateShort()
    sys.toast('已添加 ' + name)
    this.refresh()
  },

  onRowDelete(idx) {
    if (idx === undefined || !this.rows[idx]) return
    const item = this.rows[idx]
    const st = getData()
    for (let i = st.countdowns.length - 1; i >= 0; i--) {
      if ((st.countdowns[i].id || st.countdowns[i].name) === item.id) st.countdowns.splice(i, 1)
    }
    save(st)
    sys.toast('已删除 ' + item.name)
    this.refresh()
  }
}
</script>

<style>
.page {
  width: 466px;
  height: 466px;
  background-color: #000000;
}

.scroll {
  width: 466px;
  height: 466px;
}

