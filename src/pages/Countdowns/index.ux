  width: 466px;
  padding-left: 48px;
  padding-right: 48px;
  padding-top: 80px;
  padding-bottom: 100px;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}

.subtitle {
  margin-top: 6px;
  font-size: 18px;
  color: rgba(235, 235, 245, 0.4);
}

.row {
  margin-top: 12px;
  width: 370px;
  height: 72px;
  justify-content: space-between;
  border-radius: 20px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.07);
  border-style: solid;
  background: linear-gradient(to bottom right, #1d1d22, #141418);
  flex-direction: row;
  align-items: center;
  padding-left: 22px;
  padding-right: 22px;
}

.kind-dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
  margin-right: 12px;
}

.row-name {
  font-size: 23px;
  font-weight: bold;
  color: #ffffff;
}

.row-date {
  margin-left: 12px;
  font-size: 18px;
  color: rgba(235, 235, 245, 0.45);
}

.row-days {
  font-size: 20px;
  font-weight: bold;
}

.row-left {
  flex-direction: row;
  align-items: center;
}

.empty {
  margin-top: 20px;
  height: 60px;
  justify-content: center;
}

.empty-txt {
  font-size: 18px;
  color: rgba(235, 235, 245, 0.35);
}

.seg {
  margin-top: 20px;
  width: 370px;
  height: 52px;
  border-radius: 26px;
  background-color: #1c1c1e;
  flex-direction: row;
  align-items: center;
  padding-left: 6px;
  padding-right: 6px;
}

.seg-btn {
  flex-grow: 0;
  width: 179px;
  height: 40px;
  border-radius: 20px;
  justify-content: center;
  align-items: center;
  margin-left: 1px;
  margin-right: 1px;
}

.seg-on-exam {
  background-color: rgba(255, 69, 58, 0.2);
}

.seg-on-holiday {
  background-color: rgba(10, 132, 255, 0.2);
}

.seg-txt {
  font-size: 20px;
  color: rgba(235, 235, 245, 0.55);
}

.seg-txt-exam {
  color: #FF453A;
  font-weight: bold;
}

.seg-txt-holiday {
  color: #0A84FF;
  font-weight: bold;
}

.editor {
  margin-top: 16px;
  width: 370px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.08);
  border-style: solid;
  background-color: #101014;
  border-radius: 24px;
  flex-direction: column;
  align-items: center;
  padding-top: 16px;
  padding-bottom: 18px;
}

.ed-label {
  margin-top: 6px;
  font-size: 19px;
  color: rgba(235, 235, 245, 0.5);
}

.ed-picker-s {
  width: 300px;
  height: 300px;
  margin-top: 4px;
  font-size: 20px;
  color: rgba(235, 235, 245, 0.55);
  selected-font-size: 28px;
  selected-color: #ffffff;
  selected-background-color: rgba(255, 255, 255, 0.14);
  linecolor: #26262c;
}

.add-btn {
  margin-top: 12px;
  height: 52px;
  border-radius: 26px;
  background-color: #0A84FF;
  justify-content: center;
  align-items: center;
  padding-left: 30px;
  padding-right: 30px;
}

.add-txt {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
}

.gap {
  height: 10px;
}

.press:active {
  opacity: 0.72;
}

/* 方屏适配：无弧形裁边，恢复常规边距 */
@media screen and (device: watch-square) {
  .content {
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 40px;
    padding-bottom: 60px;
  }
}

</style>
