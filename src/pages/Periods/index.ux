  flex-direction: row;
  align-items: center;
}

.prow-name {
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.prow-time {
  margin-left: 16px;
  font-size: 20px;
  color: rgba(235, 235, 245, 0.55);
  lines: 1;
}

.kind-dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
}

.add-btn {
  margin-top: 16px;
  height: 56px;
  border-radius: 28px;
  border-width: 1px;
  border-color: rgba(10, 132, 255, 0.55);
  border-style: solid;
  background-color: rgba(10, 132, 255, 0.12);
  justify-content: center;
  align-items: center;
  padding-left: 30px;
  padding-right: 30px;
}

.add-txt {
  font-size: 21px;
  font-weight: bold;
  color: #0A84FF;
}

.gap {
  height: 10px;
}

/* ===== 编辑时段面板 ===== */
.mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 466px;
  height: 466px;
  background-color: rgba(0, 0, 0, 0.78);
}

.panel {
  position: absolute;
  left: 0;
