}

.add-btn {
  margin-top: 18px;
  height: 56px;
  border-radius: 28px;
  border-width: 1px;
  border-color: rgba(10, 132, 255, 0.55);
  border-style: solid;
  background-color: rgba(10, 132, 255, 0.12);
  justify-content: center;
  align-items: center;
  padding-left: 30px;
  padding-right: 30px;
}

.add-txt {
  font-size: 21px;
  font-weight: bold;
  color: #0A84FF;
}

.gap {
  height: 10px;
}

.press:active {
  opacity: 0.72;
}

/* 方屏适配：无弧形裁边，恢复常规边距 */
@media screen and (device: watch-square) {
  .content {
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 40px;
    padding-bottom: 60px;
  }
}

</style>
