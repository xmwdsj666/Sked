}

.del-btn {
  margin-top: 14px;
  height: 44px;
  border-radius: 22px;
  border-width: 1px;
  border-color: rgba(255, 69, 58, 0.5);
  border-style: solid;
  justify-content: center;
  align-items: center;
  padding-left: 24px;
  padding-right: 24px;
}

.del-txt {
  font-size: 19px;
