  margin-top: 12px;
  width: 370px;
  height: 68px;
  justify-content: space-between;
  border-radius: 20px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.07);
  border-style: solid;
  background: linear-gradient(to bottom right, #1d1d22, #141418);
  flex-direction: row;
  align-items: center;
  padding-left: 22px;
  padding-right: 22px;
}

.row-open {
  border-color: rgba(10, 132, 255, 0.7);
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  margin-bottom: 0;
}

.row-name {
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
}

