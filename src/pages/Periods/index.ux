<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true">
      <div class="content">
        <text class="title">作息时间</text>
        <text class="subtitle">点击条目编辑，长按删除</text>

        <div for="{{row in rows}}" tid="{{row.key}}">
          <div class="row press {{row.open ? 'row-open' : ''}}" onclick="onRowTap($idx)" onlongpress="onRowDelete($idx)">
            <div class="row-left">
              <text class="row-name">{{row.name}}</text>
              <text class="row-time">{{row.start}} - {{row.end}}</text>
            </div>
            <div class="kind-dot" style="background-color: {{row.kindColor}};"></div>
          </div>

          <div if="{{row.open}}" class="editor">
            <div class="f-row press" onclick="onFieldTap('name')">
              <text class="f-label">名称</text>
              <text class="f-value">{{row.name}}</text>
            </div>
            <picker if="{{subMode === 'name'}}" class="ed-picker-s" type="text" range="{{nameRange}}" selected="{{nameSel}}" onchange="onNamePick"></picker>
            <div class="f-row press" onclick="onFieldTap('start')">
              <text class="f-label">开始时间</text>
              <text class="f-value">{{row.start}}</text>
            </div>
            <picker if="{{subMode === 'start'}}" class="ed-picker-s" type="time" format="HH:mm" selected="{{row.start}}" onchange="onStartPick"></picker>
            <div class="f-row press" onclick="onFieldTap('end')">
              <text class="f-label">结束时间</text>
              <text class="f-value">{{row.end}}</text>
            </div>
            <picker if="{{subMode === 'end'}}" class="ed-picker-s" type="time" format="HH:mm" selected="{{row.end}}" onchange="onEndPick"></picker>
            <text class="ed-label">类型</text>
            <div class="pills">
              <div class="pill {{kindSel === 0 ? 'pill-on' : ''}}" onclick="onKind(0)">
                <text class="pill-txt {{kindSel === 0 ? 'pill-txt-on' : ''}}">课程</text>
              </div>
              <div class="pill {{kindSel === 1 ? 'pill-on' : ''}}" onclick="onKind(1)">
                <text class="pill-txt {{kindSel === 1 ? 'pill-txt-on' : ''}}">休息</text>
              </div>
            </div>
            <div class="del-btn press" onclick="onDelTap">
              <text class="del-txt">删除本时段</text>
            </div>
          </div>
        </div>

        <div class="add-btn press" onclick="onAdd">
          <text class="add-txt">＋ 添加时段</text>
        </div>
        <div class="gap"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
import sys from '../../helper/sys.js'
import { load, getData, save } from '../../store/index.js'
import { genId, PERIOD_NAME_PRESETS } from '../../core/defaults.js'

export default {
  data: {
    rows: [],
    nameRange: PERIOD_NAME_PRESETS,
    nameSel: 0,
    kindSel: 0,
    openId: '',
    subMode: ''
  },

  onInit() {
    this._loaded = false
  },

  onReady() {
    this._loaded = true
    load()
    this.refresh()
  },

  onShow() {
    if (this._loaded) this.refresh()
  },

  refresh() {
    if (!this._loaded) return
    const st = getData()
    if (!st) return
    const periods = (st.periods || []).slice().sort(function (a, b) { return a.start < b.start ? -1 : 1 })
    const rows = []
    for (let i = 0; i < periods.length; i++) {
      const p = periods[i]
      rows.push({
        key: p.id,
        id: p.id,
        name: p.name,
        start: p.start,
        end: p.end,
        kindColor: p.type === 'class' ? '#0A84FF' : '#48484A',
        open: this.openId === p.id
      })
    }
    this.rows = rows
  },

  onFieldTap(mode) {
    this.subMode = this.subMode === mode ? '' : mode
    sys.vibrateShort()
  },

  onRowTap(idx) {
    if (idx === undefined || !this.rows[idx]) return
    const item = this.rows[idx]
    this.subMode = ''
    if (this.openId === item.id) {
      this.openId = ''
    } else {
      this.openId = item.id
      const st = getData()
      for (let i = 0; i < st.periods.length; i++) {
        if (st.periods[i].id === item.id) {
          const p = st.periods[i]
          for (let j = 0; j < this.nameRange.length; j++) {
            if (this.nameRange[j] === p.name) { this.nameSel = j; break }
          }
          this.kindSel = p.type === 'class' ? 0 : 1
          break
        }
      }
    }
    sys.vibrateShort()
    this.refresh()
  },

  onRowDelete(idx) {
    if (idx === undefined || !this.rows[idx]) return
    const item = this.rows[idx]
    const st = getData()
    for (let i = st.periods.length - 1; i >= 0; i--) {
      if (st.periods[i].id === item.id) st.periods.splice(i, 1)
    }
    // 同步删除引用该时段的课程
    for (const d in st.courses) {
      const arr = st.courses[d]
      for (let i = arr.length - 1; i >= 0; i--) {
        if (arr[i].periodId === item.id) arr.splice(i, 1)
      }
    }
    if (this.openId === item.id) this.openId = ''
    save(st)
    sys.toast('已删除 ' + item.name)
    this.refresh()
  },

  onNamePick(e) {
    const st = getData()
    const p = this.findPeriod(st, this.openId)
    if (!p || !e) return
    p.name = e.newValue
    for (let i = 0; i < this.nameRange.length; i++) {
      if (this.nameRange[i] === e.newValue) { this.nameSel = i; break }
    }
    this.subMode = ''
    save(st)
    this.refresh()
  },

  onStartPick(e) {
    const st = getData()
    const p = this.findPeriod(st, this.openId)
    if (!p || !e) return
    p.start = (e.hour < 10 ? '0' : '') + e.hour + ':' + (e.minute < 10 ? '0' : '') + e.minute
    save(st)
    this.refresh()
  },

  onEndPick(e) {
    const st = getData()
    const p = this.findPeriod(st, this.openId)
    if (!p || !e) return
    p.end = (e.hour < 10 ? '0' : '') + e.hour + ':' + (e.minute < 10 ? '0' : '') + e.minute
    save(st)
    this.refresh()
  },

  onKind(idx) {
    this.kindSel = idx
    const st = getData()
    const p = this.findPeriod(st, this.openId)
    if (!p) return
    p.type = idx === 0 ? 'class' : 'break'
    save(st)
    this.refresh()
  },

  onDelTap() {
    const st = getData()
    for (let i = st.periods.length - 1; i >= 0; i--) {
      if (st.periods[i].id === this.openId) {
        sys.toast('已删除 ' + st.periods[i].name)
        st.periods.splice(i, 1)
        break
      }
    }
    for (const d in st.courses) {
      const arr = st.courses[d]
      for (let i = arr.length - 1; i >= 0; i--) {
        if (arr[i].periodId === this.openId) arr.splice(i, 1)
      }
    }
    this.openId = ''
    save(st)
    this.refresh()
  },

  onAdd() {
    const st = getData()
    st.periods.push({ id: genId(), name: '自习', start: '21:00', end: '21:45', type: 'class' })
    save(st)
    sys.vibrateShort()
    this.refresh()
  },

  findPeriod(st, id) {
    if (!st || !id) return null
    for (let i = 0; i < st.periods.length; i++) {
      if (st.periods[i].id === id) return st.periods[i]
    }
    return null
  }
}
</script>

<style>
.page {
  width: 466px;
  height: 466px;
  background-color: #000000;
}

.scroll {
  width: 466px;
  height: 466px;
}

