<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true">
      <div class="content">
        <text class="title">作息时间</text>
        <text class="subtitle">点击条目编辑</text>

        <div class="list">
          <div for="{{row in rows}}" tid="{{row.key}}" class="prow press" onclick="onRowTap($idx)">
            <div class="prow-left">
              <text class="prow-name">{{row.name}}</text>
              <text class="prow-time">{{row.start}} - {{row.end}}</text>
            </div>
            <div class="kind-dot" style="background-color: {{row.kindColor}};"></div>
          </div>
        </div>

        <div class="add-btn press" onclick="onAdd">
          <text class="add-txt">＋ 添加时段</text>
        </div>
        <div class="gap"></div>
      </div>
    </scroll>
    <div if="{{noticeShow}}" class="notice">
      <text class="notice-txt">{{notice}}</text>
    </div>
  </div>
</template>

<script>
/**
 * 作息时间列表页：点击/新增均跳转独立编辑页（PeriodEdit）。
 */
import sys from '../../helper/sys.js'
import { load, getData, takeNotice } from '../../store/index.js'

export default {
  data: {
    rows: [],
    notice: '',
    noticeShow: false
  },

  onInit() {
    this._loaded = false
  },

  onReady() {
    this._loaded = true
    load()
    this.refresh()
  },

  onShow() {
    if (!this._loaded) return
    this.refresh()
    const n = takeNotice()
    if (n) {
      this.notice = n
      this.noticeShow = true
      const self = this
      if (this._nt) clearTimeout(this._nt)
      this._nt = setTimeout(function () { self.noticeShow = false }, 1500)
    }
  },

  onHide() {
    if (this._nt) { clearTimeout(this._nt); this._nt = 0 }
    this.noticeShow = false
  },

  refresh() {
    if (!this._loaded) return
    const st = getData()
    if (!st) return
    const periods = (st.periods || []).slice().sort(function (a, b) { return a.start < b.start ? -1 : 1 })
    const rows = []
    for (let i = 0; i < periods.length; i++) {
      const p = periods[i]
      rows.push({
        key: p.id,
        id: p.id,
        name: p.name,
        start: p.start,
        end: p.end,
        kindColor: p.type === 'class' ? '#0A84FF' : '#48484A'
      })
    }
    this.rows = rows
  },

  onRowTap(idx) {
    if (idx === undefined || !this.rows[idx]) return
    sys.vibrateShort()
    sys.router().push({ uri: '/pages/PeriodEdit', params: { id: this.rows[idx].id } })
  },

  onAdd() {
    sys.vibrateShort()
    sys.router().push({ uri: '/pages/PeriodEdit', params: { id: 'new' } })
  }
}
</script>

<style>
.page {
  width: 466px;
  height: 466px;
  background-color: #000000;
}

.scroll {
  width: 466px;
  height: 466px;
}

.content {
  width: 466px;
  padding-left: 48px;
  padding-right: 48px;
  padding-top: 80px;
  padding-bottom: 100px;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}

.subtitle {
  margin-top: 6px;
  font-size: 18px;
  color: rgba(235, 235, 245, 0.4);
}

.list {
  margin-top: 16px;
  width: 370px;
  flex-direction: column;
}

.prow {
  width: 370px;
  height: 76px;
  border-radius: 20px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.07);
  border-style: solid;
  background: linear-gradient(to bottom right, #1d1d22, #141418);
  margin-bottom: 10px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 22px;
  padding-right: 22px;
}

.prow-left {
  flex-direction: row;
  align-items: center;
}

.prow-name {
  font-size: 24px;
  font-weight: bold;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.prow-time {
  margin-left: 16px;
  font-size: 20px;
  color: rgba(235, 235, 245, 0.55);
  lines: 1;
}

.kind-dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
}

.add-btn {
  margin-top: 16px;
  height: 56px;
  border-radius: 28px;
  border-width: 1px;
  border-color: rgba(10, 132, 255, 0.55);
  border-style: solid;
  background-color: rgba(10, 132, 255, 0.12);
  justify-content: center;
  align-items: center;
  padding-left: 30px;
  padding-right: 30px;
}

.add-txt {
  font-size: 21px;
  font-weight: bold;
  color: #0A84FF;
}

.gap {
  height: 10px;
}

.notice {
  position: absolute;
  left: 0;
  top: 90px;
  width: 466px;
  justify-content: center;
  align-items: center;
}

.notice-txt {
  font-size: 20px;
  color: #ffffff;
  background-color: rgba(28, 28, 32, 0.95);
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.12);
  border-style: solid;
  border-radius: 18px;
  padding-top: 10px;
  padding-bottom: 10px;
  padding-left: 22px;
  padding-right: 22px;
}

.press:active {
  opacity: 0.72;
}

/* 方屏适配：无弧形裁边，恢复常规边距 */
@media screen and (device: watch-square) {
  .content {
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 40px;
    padding-bottom: 60px;
  }
  .list,
  .prow {
    width: 386px;
  }
}

</style>
