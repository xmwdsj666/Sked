  width: 466px;
  height: 390px;
  background-color: #0c0c0e;
  border-top-width: 1px;
  border-top-color: rgba(255, 255, 255, 0.12);
  border-top-style: solid;
  border-top-left-radius: 30px;
  border-top-right-radius: 30px;
  flex-direction: column;
  align-items: center;
  padding-top: 16px;
}

.panel-head {
  width: 382px;
  height: 52px;
  flex-direction: row;
  align-items: center;
}

.back {
  width: 52px;
  height: 52px;
  border-radius: 26px;
  background-color: #232327;
  justify-content: center;
  align-items: center;
}

.back-txt {
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}

.panel-title {
  margin-left: 16px;
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
}

.head-spacer {
  width: 66px;
  height: 2px;
}

.del-link {
  font-size: 24px;
  font-weight: bold;
  color: #FF453A;
  padding-left: 10px;
