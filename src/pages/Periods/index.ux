<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true">
      <div class="content">
        <text class="title">作息时间</text>
        <text class="subtitle">点击条目编辑</text>

        <div class="list">
          <div for="{{row in rows}}" tid="{{row.key}}" class="prow press" onclick="onRowTap($idx)">
            <div class="prow-left">
              <text class="prow-name">{{row.name}}</text>
              <text class="prow-time">{{row.start}} - {{row.end}}</text>
            </div>
            <div class="kind-dot" style="background-color: {{row.kindColor}};"></div>
          </div>
        </div>

        <div class="add-btn press" onclick="onAdd">
          <text class="add-txt">＋ 添加时段</text>
        </div>
        <div class="gap"></div>
      </div>
    </scroll>

    <!-- 编辑时段面板：草稿修改，点「保存」才写入 -->
    <div if="{{panelShow}}" class="mask">
      <div class="panel">
        <div class="panel-head">
          <div class="back press" onclick="onPanelClose">
            <text class="back-txt">‹</text>
          </div>
          <text class="panel-title">编辑时段</text>
          <div class="head-spacer"></div>
          <text class="del-link press" onclick="onDelete">删除</text>
        </div>

        <!-- 字段选择：面板同一时刻只显示一个 picker；独立 if 分支（不用 elif 链） -->
        <div class="seg">
          <div class="seg-btn {{segSel === 0 ? 'seg-on' : ''}}" onclick="onSegName">
            <text class="seg-txt">名称</text>
          </div>
          <div class="seg-btn {{segSel === 1 ? 'seg-on' : ''}}" onclick="onSegStart">
            <text class="seg-txt">开始</text>
          </div>
          <div class="seg-btn {{segSel === 2 ? 'seg-on' : ''}}" onclick="onSegEnd">
            <text class="seg-txt">结束</text>
          </div>
          <div class="seg-btn {{segSel === 3 ? 'seg-on' : ''}}" onclick="onSegKind">
            <text class="seg-txt">类型</text>
          </div>
        </div>

        <div class="field-box">
          <picker if="{{segSel === 0}}" class="ed-picker" type="text" range="{{nameRange}}" selected="{{nameSel}}" onchange="onNamePick"></picker>
          <picker if="{{segSel === 1}}" class="ed-picker" type="time" format="HH:mm" selected="{{draft.start}}" onchange="onStartPick"></picker>
          <picker if="{{segSel === 2}}" class="ed-picker" type="time" format="HH:mm" selected="{{draft.end}}" onchange="onEndPick"></picker>
          <div if="{{segSel === 3}}" class="kind-row">
            <div class="pill {{draft.type === 'class' ? 'pill-on' : ''}}" onclick="onKindClass">
              <text class="pill-txt {{draft.type === 'class' ? 'pill-txt-on' : ''}}">课程</text>
            </div>
            <div class="pill {{draft.type === 'break' ? 'pill-on' : ''}}" onclick="onKindBreak">
              <text class="pill-txt {{draft.type === 'break' ? 'pill-txt-on' : ''}}">休息</text>
            </div>
          </div>
        </div>

        <div class="save-btn press" onclick="onSave">
          <text class="save-txt">保存</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import sys from '../../helper/sys.js'
import { load, getData, save } from '../../store/index.js'
import { genId, PERIOD_NAME_PRESETS } from '../../core/defaults.js'
import { isValidPeriodRange } from '../../core/timetable.js'

export default {
  data: {
    rows: [],
    panelShow: false,
    isNew: false,
    segSel: 0,
    nameRange: PERIOD_NAME_PRESETS,
    nameSel: 0,
    draft: { id: '', name: '', start: '08:00', end: '08:45', type: 'class' }
  },

  onInit() {
    this._loaded = false
  },

  onReady() {
    this._loaded = true
    load()
    this.refresh()
  },

  onShow() {
    if (this._loaded) this.refresh()
  },

  refresh() {
    if (!this._loaded) return
    const st = getData()
    if (!st) return
    const periods = (st.periods || []).slice().sort(function (a, b) { return a.start < b.start ? -1 : 1 })
    const rows = []
    for (let i = 0; i < periods.length; i++) {
      const p = periods[i]
      rows.push({
        key: p.id,
        id: p.id,
        name: p.name,
        start: p.start,
        end: p.end,
        kindColor: p.type === 'class' ? '#0A84FF' : '#48484A'
      })
    }
    this.rows = rows
  },

  openPanel(draft, isNew) {
    this.draft = draft
    this.isNew = isNew
    this.segSel = 0
    this.nameSel = 0
    for (let j = 0; j < this.nameRange.length; j++) {
      if (this.nameRange[j] === draft.name) { this.nameSel = j; break }
    }
    this.panelShow = true
  },

  onRowTap(idx) {
    if (idx === undefined || !this.rows[idx]) return
    const item = this.rows[idx]
    this.openPanel({
      id: item.id,
      name: item.name,
      start: item.start,
      end: item.end,
      type: item.kindColor === '#0A84FF' ? 'class' : 'break'
    }, false)
    sys.vibrateShort()
  },

  onAdd() {
    this.openPanel({
      id: genId(),
      name: '自习',
      start: '21:00',
      end: '21:45',
      type: 'class'
    }, true)
    sys.vibrateShort()
  },

  onSegName() {
    this.segSel = 0
    sys.vibrateShort()
  },

  onSegStart() {
    this.segSel = 1
    sys.vibrateShort()
  },

  onSegEnd() {
    this.segSel = 2
    sys.vibrateShort()
  },

  onSegKind() {
    this.segSel = 3
    sys.vibrateShort()
  },

  onPanelClose() {
    this.panelShow = false
  },

  onNamePick(e) {
    if (!e) return
    this.draft.name = e.newValue
    for (let i = 0; i < this.nameRange.length; i++) {
      if (this.nameRange[i] === e.newValue) { this.nameSel = i; break }
    }
  },

  onStartPick(e) {
    if (!e) return
    this.draft.start = (e.hour < 10 ? '0' : '') + e.hour + ':' + (e.minute < 10 ? '0' : '') + e.minute
  },

  onEndPick(e) {
    if (!e) return
    this.draft.end = (e.hour < 10 ? '0' : '') + e.hour + ':' + (e.minute < 10 ? '0' : '') + e.minute
  },

  onKindClass() {
    this.draft.type = 'class'
    sys.vibrateShort()
  },

  onKindBreak() {
    this.draft.type = 'break'
    sys.vibrateShort()
  },

  onSave() {
    const d = this.draft
    if (!d.name) { sys.toast('请设置名称'); return }
    if (!isValidPeriodRange(d.start, d.end)) {
      sys.toast('开始时间需早于结束时间')
      return
    }
    const st = getData()
    if (!st) return
    let p = null
    for (let i = 0; i < st.periods.length; i++) {
      if (st.periods[i].id === d.id) { p = st.periods[i]; break }
    }
    if (!p) {
      p = { id: d.id }
      st.periods.push(p)
    }
    p.name = d.name
    p.start = d.start
    p.end = d.end
    const prevType = p.type
    p.type = d.type
    // 变成休息的时段不再承载课程，清理引用
    if (prevType === 'class' && d.type === 'break') {
      for (const day in st.courses) {
        const arr = st.courses[day]
        for (let i = arr.length - 1; i >= 0; i--) {
          if (arr[i].periodId === d.id) arr.splice(i, 1)
        }
      }
    }
    const ok = save(st)
    this.panelShow = false
    sys.toast(ok ? '已保存' : '保存失败，请重试')
    sys.vibrateShort()
    this.refresh()
  },

  onDelete() {
    const st = getData()
    const d = this.draft
    if (!st || !d.id) return
    for (let i = st.periods.length - 1; i >= 0; i--) {
      if (st.periods[i].id === d.id) st.periods.splice(i, 1)
    }
    for (const day in st.courses) {
      const arr = st.courses[day]
      for (let i = arr.length - 1; i >= 0; i--) {
        if (arr[i].periodId === d.id) arr.splice(i, 1)
      }
    }
    const ok = save(st)
    this.panelShow = false
    sys.toast(ok ? ('已删除 ' + d.name) : '删除失败，请重试')
    sys.vibrateShort()
    this.refresh()
  }
}
</script>

<style>
.page {
  width: 466px;
  height: 466px;
  background-color: #000000;
  position: relative;
}

.scroll {
  width: 466px;
  height: 466px;
}

