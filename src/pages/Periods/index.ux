}

.seg {
  margin-top: 10px;
  width: 382px;
  height: 56px;
  border-radius: 18px;
  background-color: #17171b;
  flex-direction: row;
  align-items: center;
  padding-left: 5px;
  padding-right: 5px;
}

.seg-btn {
  width: 90px;
  height: 46px;
  border-radius: 13px;
  justify-content: center;
  align-items: center;
  margin-left: 1px;
  margin-right: 1px;
}

.seg-on {
  background-color: #2a2a31;
}

.seg-txt {
  font-size: 21px;
  color: rgba(235, 235, 245, 0.55);
}

.field-box {
  margin-top: 8px;
  width: 382px;
  height: 170px;
  justify-content: center;
  align-items: center;
}

.ed-picker {
  width: 340px;
  height: 170px;
  font-size: 22px;
  color: rgba(235, 235, 245, 0.4);
  selected-font-size: 32px;
  selected-color: #ffffff;
  selected-background-color: rgba(10, 132, 255, 0.15);
  linecolor: #26262c;
}

.kind-row {
  flex-direction: row;
  justify-content: center;
