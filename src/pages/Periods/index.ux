  margin-left: 16px;
  font-size: 19px;
  color: rgba(235, 235, 245, 0.55);
}

.kind-dot {
  width: 12px;
  height: 12px;
  border-radius: 6px;
}

.row-left {
  flex-direction: row;
  align-items: center;
}

.editor {
  width: 370px;
  border-width: 1px;
  border-color: rgba(10, 132, 255, 0.4);
  border-style: solid;
  border-top-width: 0;
  background-color: #101014;
  border-bottom-left-radius: 20px;
  border-bottom-right-radius: 20px;
  margin-bottom: 12px;
  flex-direction: column;
  align-items: center;
  padding-top: 14px;
  padding-bottom: 18px;
}

.f-row {
  width: 300px;
  height: 54px;
  border-bottom-width: 1px;
  border-bottom-color: rgba(255, 255, 255, 0.08);
  border-bottom-style: solid;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 4px;
}

.f-label {
  font-size: 19px;
  color: rgba(235, 235, 245, 0.5);
}

.f-value {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
}

.ed-label {
  margin-top: 8px;
  font-size: 18px;
  color: rgba(235, 235, 245, 0.5);
}

.ed-picker-s {
  width: 300px;
  height: 110px;
  margin-top: 4px;
  font-size: 20px;
  color: rgba(235, 235, 245, 0.4);
  selected-font-size: 28px;
  selected-color: #ffffff;
  selected-background-color: rgba(10, 132, 255, 0.15);
  linecolor: #26262c;
}

.pills {
  margin-top: 10px;
  flex-direction: row;
}

.pill {
  height: 42px;
  border-radius: 21px;
  background-color: #1c1c1e;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.08);
  border-style: solid;
  justify-content: center;
  align-items: center;
  padding-left: 18px;
  padding-right: 18px;
  margin-left: 7px;
  margin-right: 7px;
}

.pill-on {
  background-color: #ffffff;
  border-color: #ffffff;
}

.pill-txt {
  font-size: 19px;
