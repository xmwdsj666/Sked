  background-color: #0A84FF;
  justify-content: center;
  align-items: center;
}

.save-txt {
  font-size: 25px;
  font-weight: bold;
  color: #ffffff;
}

.press:active {
  opacity: 0.72;
}

/* 方屏适配：无弧形裁边，恢复常规边距 */
@media screen and (device: watch-square) {
  .content {
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 40px;
    padding-bottom: 60px;
  }
  .list,
  .prow {
    width: 386px;
  }
  .panel-head,
  .seg,
  .field-box,
  .ed-picker,
  .save-btn {
    width: 370px;
  }
}

</style>
