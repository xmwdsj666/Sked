  width: 370px;
  height: 76px;
  border-radius: 20px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.07);
  border-style: solid;
  background: linear-gradient(to bottom right, #1d1d22, #141418);
  margin-bottom: 10px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding-left: 22px;
  padding-right: 22px;
}

