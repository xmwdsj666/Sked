  align-items: center;
  padding-left: 32px;
  padding-right: 32px;
  margin-left: 10px;
  margin-right: 10px;
}

.pill-on {
  background-color: #0A84FF;
  border-color: #0A84FF;
}

.pill-txt {
  font-size: 23px;
  color: rgba(235, 235, 245, 0.75);
}

.pill-txt-on {
  color: #ffffff;
  font-weight: bold;
}

.save-btn {
  margin-top: 10px;
  width: 382px;
  height: 60px;
