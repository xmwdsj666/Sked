<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true">
      <div class="content">
        <div class="head">
          <div class="back press" onclick="onBack">
            <text class="back-txt">‹</text>
          </div>
          <text class="head-title">编辑时段</text>
        </div>

        <text class="ed-label">类型</text>
        <picker class="ed-picker" type="text" range="{{typeRange}}" selected="{{typeSel}}" onchange="onTypePick"></picker>

        <text class="ed-label">名称</text>
        <picker class="ed-picker" type="text" range="{{nameRange}}" selected="{{nameSel}}" onchange="onNamePick"></picker>

        <text class="ed-label">开始时间</text>
        <div class="t-row">
          <picker class="ed-picker ed-half" type="text" range="{{startHRange}}" selected="{{startSelH}}" onchange="onStartH"></picker>
          <picker class="ed-picker ed-half" type="text" range="{{startMRange}}" selected="{{startSelM}}" onchange="onStartM"></picker>
        </div>

        <text class="ed-label">结束时间</text>
        <div class="t-row">
          <picker class="ed-picker ed-half" type="text" range="{{endHRange}}" selected="{{endSelH}}" onchange="onEndH"></picker>
          <picker class="ed-picker ed-half" type="text" range="{{endMRange}}" selected="{{endSelM}}" onchange="onEndM"></picker>
        </div>

        <div class="save-btn press" onclick="onSave">
          <text class="save-txt">保存</text>
        </div>
        <div if="{{!isNew}}" class="del-btn press" onclick="onDelete">
          <text class="del-txt">删除本时段</text>
        </div>

        <div class="gap"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
/**
 * 时段编辑页（独立路由页，替代原底部面板）：
 * 全部控件静态常驻，无条件挂载/遮罩层——规避真机点击卡死问题。
 * 草稿字段全部平铺在 data（pName/pStart/pEnd/pType），保存才写入 store。
 * 时间字段不用 type="time" picker（关联 deliverPositionEvent 投递失败），
 * 改为与名称同形态的单列文本 picker（时/分双列，条目自带「时/分」单位）。
 */
import sys from '../../helper/sys.js'
import { load, getData, save, setNotice } from '../../store/index.js'
import { genId, PERIOD_NAME_PRESETS } from '../../core/defaults.js'
import { isValidPeriodRange } from '../../core/timetable.js'

const HOUR_ITEMS = []
const MINUTE_ITEMS = []
for (let i = 0; i < 24; i++) HOUR_ITEMS.push((i < 10 ? '0' : '') + i + '时')
for (let i = 0; i < 60; i++) MINUTE_ITEMS.push((i < 10 ? '0' : '') + i + '分')

export default {
  data: {
    id: '',
    isNew: false,
    nameRange: PERIOD_NAME_PRESETS,
    nameSel: 0,
    startHRange: HOUR_ITEMS,
    startMRange: MINUTE_ITEMS,
    endHRange: HOUR_ITEMS,
    endMRange: MINUTE_ITEMS,
    startSelH: 8,
    startSelM: 0,
    endSelH: 21,
    endSelM: 45,
    typeRange: ['课程', '休息'],
    typeSel: 0,
    pName: '',
    pStart: '08:00',
    pEnd: '08:45',
    startInit: '08:00',
    endInit: '08:45',
    pType: 'class'
  },

  onInit() {
    this._loaded = false
  },

  onReady() {
    load()
    const st = getData()
    if (!st) {
      sys.router().back()
      return
    }
    if (this.id === 'new') {
      this.isNew = true
      this.pName = '自习'
      this.pStart = '21:00'
      this.pEnd = '21:45'
      this.startInit = this.pStart
      this.endInit = this.pEnd
      this.pType = 'class'
    } else {
      let p = null
      for (let i = 0; i < st.periods.length; i++) {
        if (st.periods[i].id === this.id) { p = st.periods[i]; break }
      }
      if (!p) {
        // 条目不存在（已删除等）：返回列表
        sys.router().back()
        return
      }
      this.pName = p.name
      this.pStart = p.start
      this.pEnd = p.end
      this.startInit = p.start
      this.endInit = p.end
      this.pType = p.type
    }
    // range 从 00 开始递增，条目下标即数值；selected 只作初始定位，change 不回写
    this.startSelH = parseInt(this.pStart.slice(0, 2))
    this.startSelM = parseInt(this.pStart.slice(3, 5))
    this.endSelH = parseInt(this.pEnd.slice(0, 2))
    this.endSelM = parseInt(this.pEnd.slice(3, 5))
    for (let j = 0; j < this.nameRange.length; j++) {
      if (this.nameRange[j] === this.pName) { this.nameSel = j; break }
    }
    this.typeSel = this.pType === 'break' ? 1 : 0
    this._loaded = true
  },

  onNamePick(e) {
    if (!e) return
    this.pName = e.newValue
  },

  onStartH(e) {
    if (!e) return
    const v = parseInt(e.newValue)
    if (isNaN(v) || v < 0 || v > 23) return
    this.pStart = (v < 10 ? '0' : '') + v + this.pStart.slice(2, 5)
  },

  onStartM(e) {
    if (!e) return
    const v = parseInt(e.newValue)
    if (isNaN(v) || v < 0 || v > 59) return
    this.pStart = this.pStart.slice(0, 3) + (v < 10 ? '0' : '') + v
  },

  onEndH(e) {
    if (!e) return
    const v = parseInt(e.newValue)
    if (isNaN(v) || v < 0 || v > 23) return
    this.pEnd = (v < 10 ? '0' : '') + v + this.pEnd.slice(2, 5)
  },

  onEndM(e) {
    if (!e) return
    const v = parseInt(e.newValue)
    if (isNaN(v) || v < 0 || v > 59) return
    this.pEnd = this.pEnd.slice(0, 3) + (v < 10 ? '0' : '') + v
  },

  onTypePick(e) {
    if (!e) return
    this.pType = e.newValue === '休息' ? 'break' : 'class'
  },

  onSave() {
    if (!this._loaded) return
    if (!this.pName) { sys.toast('请设置名称'); return }
    if (!isValidPeriodRange(this.pStart, this.pEnd)) {
      sys.toast('开始时间需早于结束时间')
      return
    }
    const st = getData()
    if (!st) return
    let p = null
    for (let i = 0; i < st.periods.length; i++) {
      if (st.periods[i].id === this.id) { p = st.periods[i]; break }
    }
    if (!p) {
      p = { id: genId() }
      st.periods.push(p)
    }
    const prevType = p.type
    p.name = this.pName
    p.start = this.pStart
    p.end = this.pEnd
    p.type = this.pType
    // 变成休息的时段不再承载课程，清理引用
    if (prevType === 'class' && this.pType === 'break') {
      for (const day in st.courses) {
        const arr = st.courses[day]
        for (let i = arr.length - 1; i >= 0; i--) {
          if (arr[i].periodId === p.id) arr.splice(i, 1)
        }
      }
    }
    const ok = save(st)
    if (ok) setNotice('已保存'); else sys.toast('保存失败，请重试')
    sys.vibrateShort()
    sys.router().back()
  },

  onDelete() {
    const st = getData()
    if (!st || !this.id) return
    for (let i = st.periods.length - 1; i >= 0; i--) {
      if (st.periods[i].id === this.id) st.periods.splice(i, 1)
    }
    for (const day in st.courses) {
      const arr = st.courses[day]
      for (let i = arr.length - 1; i >= 0; i--) {
        if (arr[i].periodId === this.id) arr.splice(i, 1)
      }
    }
    const ok = save(st)
    if (ok) setNotice('已删除'); else sys.toast('删除失败，请重试')
    sys.vibrateShort()
    sys.router().back()
  },

  onBack() {
    sys.router().back()
  }
}
</script>

<style>
.page {
  width: 466px;
  height: 466px;
  background-color: #000000;
}

.scroll {
  width: 466px;
  height: 466px;
}

.content {
  width: 466px;
  padding-left: 48px;
  padding-right: 48px;
  padding-top: 60px;
  padding-bottom: 90px;
  flex-direction: column;
  align-items: center;
}

.head {
  width: 370px;
  height: 60px;
  flex-direction: row;
  align-items: center;
}

.back {
  width: 52px;
  height: 52px;
  border-radius: 26px;
  background-color: #232327;
  justify-content: center;
  align-items: center;
}

.back-txt {
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}

.head-title {
  margin-left: 16px;
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
}

.ed-label {
  margin-top: 10px;
  width: 370px;
  font-size: 26px;
  font-weight: bold;
  color: rgba(235, 235, 245, 0.85);
}

.ed-picker {
  margin-top: 4px;
  width: 370px;
  height: 300px;
  font-size: 24px;
  color: rgba(235, 235, 245, 0.55);
  selected-font-size: 36px;
  selected-color: #ffffff;
  selected-background-color: rgba(255, 255, 255, 0.16);
  linecolor: #26262c;
}

.t-row {
  margin-top: 4px;
  width: 370px;
  height: 300px;
  flex-direction: row;
}

.ed-half {
  margin-top: 0;
  width: 185px;
  height: 300px;
  selected-font-size: 30px;
}

.save-btn {
  margin-top: 18px;
  width: 370px;
  height: 60px;
  border-radius: 16px;
  background-color: #0A84FF;
  justify-content: center;
  align-items: center;
}

.save-txt {
  font-size: 25px;
  font-weight: bold;
  color: #ffffff;
}

.del-btn {
  margin-top: 10px;
  width: 370px;
  height: 54px;
  border-radius: 16px;
  border-width: 1px;
  border-color: rgba(255, 69, 58, 0.65);
  border-style: solid;
  background-color: rgba(255, 69, 58, 0.06);
  justify-content: center;
  align-items: center;
}

.del-txt {
  font-size: 22px;
  font-weight: bold;
  color: #FF453A;
}

.gap {
  height: 10px;
}

.press:active {
  opacity: 0.72;
}

/* 方屏适配：无弧形裁边，恢复常规边距 */
@media screen and (device: watch-square) {
  .content {
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 36px;
    padding-bottom: 50px;
  }
  .head,
  .ed-label,
  .ed-picker,
  .t-row,
  .save-btn,
  .del-btn {
    width: 386px;
  }
  .ed-half {
    width: 193px;
  }
}

</style>
