<template>
  <div class="page">
    <scroll class="scroll" scroll-y="true">
      <div class="content">
        <div class="head">
          <div class="back press" onclick="onBack">
            <text class="back-txt">‹</text>
          </div>
          <text class="head-title">编辑时段</text>
        </div>

        <!-- 类型置顶：始终可见可点 -->
        <text class="ed-label">类型</text>
        <div class="pills">
          <div class="pill {{pType === 'class' ? 'pill-on' : ''}}" onclick="onKindClass">
            <text class="pill-txt {{pType === 'class' ? 'pill-txt-on' : ''}}">课程</text>
          </div>
          <div class="pill {{pType === 'break' ? 'pill-on' : ''}}" onclick="onKindBreak">
            <text class="pill-txt {{pType === 'break' ? 'pill-txt-on' : ''}}">休息</text>
          </div>
        </div>

        <text class="ed-label">名称</text>
        <picker class="ed-picker" type="text" range="{{nameRange}}" selected="{{nameSel}}" loop="true" onchange="onNamePick"></picker>

        <text class="ed-label">开始时间</text>
        <picker class="ed-picker" type="time" format="HH:mm" selected="{{pStart}}" loop="true" onchange="onStartPick"></picker>

        <text class="ed-label">结束时间</text>
        <picker class="ed-picker" type="time" format="HH:mm" selected="{{pEnd}}" loop="true" onchange="onEndPick"></picker>

        <div class="save-btn press" onclick="onSave">
          <text class="save-txt">保存</text>
        </div>
        <div if="{{!isNew}}" class="del-btn press" onclick="onDelete">
          <text class="del-txt">删除本时段</text>
        </div>

        <div class="gap"></div>
      </div>
    </scroll>
  </div>
</template>

<script>
/**
 * 时段编辑页（独立路由页，替代原底部面板）：
 * 全部控件静态常驻，无条件挂载/遮罩层——规避真机点击卡死问题。
 * 草稿字段全部平铺在 data（pName/pStart/pEnd/pType），保存才写入 store。
 */
import sys from '../../helper/sys.js'
import { load, getData, save } from '../../store/index.js'
import { genId, PERIOD_NAME_PRESETS } from '../../core/defaults.js'
import { isValidPeriodRange } from '../../core/timetable.js'

export default {
  data: {
    id: '',
    isNew: false,
    nameRange: PERIOD_NAME_PRESETS,
    nameSel: 0,
    pName: '',
    pStart: '08:00',
    pEnd: '08:45',
    pType: 'class'
  },

  onInit() {
    this._loaded = false
  },

  onReady() {
    load()
    const st = getData()
    if (!st) {
      sys.router().back()
      return
    }
    if (this.id === 'new') {
      this.isNew = true
      this.pName = '自习'
      this.pStart = '21:00'
      this.pEnd = '21:45'
      this.pType = 'class'
    } else {
      let p = null
      for (let i = 0; i < st.periods.length; i++) {
        if (st.periods[i].id === this.id) { p = st.periods[i]; break }
      }
      if (!p) {
        // 条目不存在（已删除等）：返回列表
        sys.router().back()
        return
      }
      this.pName = p.name
      this.pStart = p.start
      this.pEnd = p.end
      this.pType = p.type
    }
    for (let j = 0; j < this.nameRange.length; j++) {
      if (this.nameRange[j] === this.pName) { this.nameSel = j; break }
    }
    this._loaded = true
  },

  onNamePick(e) {
    if (!e) return
    this.pName = e.newValue
    for (let i = 0; i < this.nameRange.length; i++) {
      if (this.nameRange[i] === e.newValue) { this.nameSel = i; break }
    }
  },

  onStartPick(e) {
    if (!e) return
    this.pStart = (e.hour < 10 ? '0' : '') + e.hour + ':' + (e.minute < 10 ? '0' : '') + e.minute
  },

  onEndPick(e) {
    if (!e) return
    this.pEnd = (e.hour < 10 ? '0' : '') + e.hour + ':' + (e.minute < 10 ? '0' : '') + e.minute
  },

  onKindClass() {
    this.pType = 'class'
    sys.vibrateShort()
  },

  onKindBreak() {
    this.pType = 'break'
    sys.vibrateShort()
  },

  onSave() {
    if (!this._loaded) return
    if (!this.pName) { sys.toast('请设置名称'); return }
    if (!isValidPeriodRange(this.pStart, this.pEnd)) {
      sys.toast('开始时间需早于结束时间')
      return
    }
    const st = getData()
    if (!st) return
    let p = null
    for (let i = 0; i < st.periods.length; i++) {
      if (st.periods[i].id === this.id) { p = st.periods[i]; break }
    }
    if (!p) {
      p = { id: genId() }
      st.periods.push(p)
    }
    const prevType = p.type
    p.name = this.pName
    p.start = this.pStart
    p.end = this.pEnd
    p.type = this.pType
    // 变成休息的时段不再承载课程，清理引用
    if (prevType === 'class' && this.pType === 'break') {
      for (const day in st.courses) {
        const arr = st.courses[day]
        for (let i = arr.length - 1; i >= 0; i--) {
          if (arr[i].periodId === p.id) arr.splice(i, 1)
        }
      }
    }
    const ok = save(st)
    sys.toast(ok ? '已保存' : '保存失败，请重试')
    sys.vibrateShort()
    sys.router().back()
  },

  onDelete() {
    const st = getData()
    if (!st || !this.id) return
    for (let i = st.periods.length - 1; i >= 0; i--) {
      if (st.periods[i].id === this.id) st.periods.splice(i, 1)
    }
    for (const day in st.courses) {
      const arr = st.courses[day]
      for (let i = arr.length - 1; i >= 0; i--) {
        if (arr[i].periodId === this.id) arr.splice(i, 1)
      }
    }
    const ok = save(st)
    sys.toast(ok ? '已删除' : '删除失败，请重试')
    sys.vibrateShort()
    sys.router().back()
  },

  onBack() {
    sys.router().back()
  }
}
</script>

<style>
.page {
  width: 466px;
  height: 466px;
  background-color: #000000;
}

.scroll {
  width: 466px;
  height: 466px;
}

.content {
  width: 466px;
  padding-left: 48px;
  padding-right: 48px;
  padding-top: 60px;
  padding-bottom: 90px;
  flex-direction: column;
  align-items: center;
}

.head {
  width: 370px;
  height: 60px;
  flex-direction: row;
  align-items: center;
}

.back {
  width: 52px;
  height: 52px;
  border-radius: 26px;
  background-color: #232327;
  justify-content: center;
  align-items: center;
}

.back-txt {
  font-size: 34px;
  font-weight: bold;
  color: #ffffff;
}

.head-title {
  margin-left: 16px;
  font-size: 30px;
  font-weight: bold;
  color: #ffffff;
}

.ed-label {
  margin-top: 14px;
  width: 370px;
  font-size: 19px;
  color: rgba(235, 235, 245, 0.5);
}

.ed-picker {
  margin-top: 6px;
  width: 370px;
  height: 300px;
  font-size: 22px;
  color: rgba(235, 235, 245, 0.4);
  selected-font-size: 30px;
  selected-color: #ffffff;
  selected-background-color: rgba(255, 255, 255, 0.08);
  linecolor: #26262c;
}

.pills {
  margin-top: 10px;
  width: 370px;
  flex-direction: row;
  justify-content: center;
}

.pill {
  height: 52px;
  border-radius: 26px;
  background-color: #1c1c1e;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.08);
  border-style: solid;
  justify-content: center;
  align-items: center;
  padding-left: 30px;
  padding-right: 30px;
  margin-left: 10px;
  margin-right: 10px;
}

.pill-on {
  background-color: #0A84FF;
  border-color: #0A84FF;
}

.pill-txt {
  font-size: 22px;
  color: rgba(235, 235, 245, 0.75);
}

.pill-txt-on {
  color: #ffffff;
  font-weight: bold;
}

.save-btn {
  margin-top: 18px;
  width: 370px;
  height: 60px;
  border-radius: 16px;
  background-color: #0A84FF;
  justify-content: center;
  align-items: center;
}

.save-txt {
  font-size: 25px;
  font-weight: bold;
  color: #ffffff;
}

.del-btn {
  margin-top: 10px;
  width: 370px;
  height: 54px;
  border-radius: 16px;
  border-width: 1px;
  border-color: rgba(255, 69, 58, 0.65);
  border-style: solid;
  background-color: rgba(255, 69, 58, 0.06);
  justify-content: center;
  align-items: center;
}

.del-txt {
  font-size: 22px;
  font-weight: bold;
  color: #FF453A;
}

.gap {
  height: 10px;
}

.press:active {
  opacity: 0.72;
}

/* 方屏适配：无弧形裁边，恢复常规边距 */
@media screen and (device: watch-square) {
  .content {
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 36px;
    padding-bottom: 50px;
  }
  .head,
  .ed-label,
  .ed-picker,
  .pills,
  .save-btn,
  .del-btn {
    width: 386px;
  }
}

</style>
