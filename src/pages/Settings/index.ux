  margin-top: 18px;
  width: 370px;
  height: 92px;
  border-radius: 24px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.07);
  border-style: solid;
  background: linear-gradient(to bottom right, #1d1d22, #141418);
  flex-direction: column;
  justify-content: center;
  padding-left: 24px;
  padding-right: 24px;
}

.card-title {
  font-size: 22px;
  color: rgba(235, 235, 245, 0.55);
}

.card-value {
  margin-top: 6px;
  font-size: 26px;
  font-weight: bold;
  color: #ffffff;
}

.card-danger {
  margin-top: 18px;
  width: 370px;
  height: 76px;
  border-radius: 24px;
  border-width: 1px;
  border-color: rgba(255, 69, 58, 0.4);
  border-style: solid;
  background: linear-gradient(to bottom right, #241416, #160d0e);
  justify-content: center;
  padding-left: 24px;
}

.card-title-danger {
  font-size: 24px;
  font-weight: bold;
  color: #FF453A;
}

.editor {
  margin-top: 10px;
  width: 370px;
  border-width: 1px;
  border-color: rgba(10, 132, 255, 0.4);
  border-style: solid;
  background-color: #101014;
  border-radius: 24px;
  flex-direction: column;
  align-items: center;
  padding-top: 12px;
  padding-bottom: 16px;
}

.ed-picker {
  width: 330px;
  height: 300px;
  font-size: 22px;
  color: rgba(235, 235, 245, 0.4);
  selected-font-size: 32px;
  selected-color: #ffffff;
  selected-background-color: rgba(10, 132, 255, 0.15);
  linecolor: #26262c;
}

.done-btn {
  margin-top: 8px;
  height: 44px;
  border-radius: 22px;
  background-color: #0A84FF;
  justify-content: center;
  align-items: center;
  padding-left: 30px;
  padding-right: 30px;
}

.done-txt {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
}

.hint {
  margin-top: 8px;
