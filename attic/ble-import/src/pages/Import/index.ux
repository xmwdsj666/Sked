  margin-top: 6px;
  font-size: 19px;
  color: rgba(235, 235, 245, 0.5);
}

.card {
  margin-top: 18px;
  width: 370px;
  border-radius: 24px;
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.09);
  border-style: solid;
  background: linear-gradient(to bottom right, #1d1d22, #141418);
  flex-direction: column;
  align-items: center;
  padding-top: 16px;
  padding-bottom: 16px;
}

.s-row {
  width: 330px;
  height: 52px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.s-label {
  font-size: 20px;
  color: rgba(235, 235, 245, 0.55);
}

.s-value {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
}

.hint {
  margin-top: 8px;
  font-size: 16px;
  color: rgba(235, 235, 245, 0.35);
}

.empty-txt {
  margin-top: 10px;
  font-size: 21px;
  color: rgba(235, 235, 245, 0.5);
}

.btn-row {
  margin-top: 22px;
  width: 370px;
  height: 64px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.btn {
  width: 175px;
  height: 60px;
  border-radius: 30px;
  justify-content: center;
  align-items: center;
}

.btn-primary {
  background-color: #0A84FF;
}

.btn-ghost {
  border-width: 1px;
  border-color: rgba(255, 255, 255, 0.18);
  border-style: solid;
  background-color: #1c1c1e;
}

.btn-txt-primary {
  font-size: 22px;
  font-weight: bold;
  color: #ffffff;
}

.btn-txt-ghost {
  font-size: 22px;
  color: rgba(235, 235, 245, 0.75);
}

.btn-disabled {
  opacity: 0.4;
}

.gap {
  height: 10px;
}

